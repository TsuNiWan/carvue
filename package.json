{
  "name": "carvue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/copy-notices.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:soak": "node e2e/run-soak.mjs",
    "validate:assets": "node scripts/validate-assets.mjs --report",
    "preview": "vite preview --host 127.0.0.1",
    "validate:public": "node scripts/verification/public-contract.mjs",
    "test:rigs": "node scripts/verification/verify-delivery-rigs.mjs"
  },
  "dependencies": {
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.15",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "meshoptimizer": "^1.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
